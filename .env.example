# Local development environment (copy to .env)
# Dockerized Postgres used for local dev + integration tests (DSQL has no emulator).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sparkle_dev

# Local API server port (@hono/node-server)
PORT=8787

# --- Spike A: Aurora DSQL ---
AWS_REGION=us-east-1
DSQL_ENDPOINT=

# --- Local S3-compatible media storage (Floci) ---
# Start Floci with `docker compose up -d`; Compose creates the bucket
# automatically through the media-init service.
MEDIA_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- Spike B: auth split ---
# Dev-only escape hatch allowing unsigned bearer tokens locally. NEVER set in deployed envs.
ALLOW_INSECURE_DEV_AUTH=true
SPIKE_USERNAME=spike
SPIKE_API_TOKEN=spike-token-change-me
# HMAC key for greader credential derivation (local/tests; prod uses HMAC_SECRET_ARN)
GREADER_HMAC_KEY=local-dev-hmac-key-change-me
COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# CORS origins (comma-separated) allowed by the API layer
WEB_ORIGINS=http://localhost:5173

# --- Local dev web app ---
# VITE_* vars are read by the web app from this root .env (vite envDir).
# Skips Cognito in the browser; requests carry X-Dev-User instead.
VITE_AUTH_DISABLED=true
# Optional: run the local UI against a deployed API instead of localhost:8787
# API_TARGET=https://app.sparklerss.com
