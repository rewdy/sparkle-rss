{
  "name": "@sparkle/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate && node scripts/inline-fks.mjs",
    "migrate": "tsx src/migrate.ts",
    "migrate:local": "tsx src/migrate-local.ts",
    "push:local": "drizzle-kit push"
  },
  "dependencies": {
    "@aws-sdk/dsql-signer": "^3.1116.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@sparkle/tooling": "workspace:*",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@sparkle/core": "workspace:*"
  }
}
