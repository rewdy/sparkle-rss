{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": { "enabled": false, "clientKind": "git" },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.json",
      "!**/dist",
      "!**/coverage",
      "!**/drizzle",
      "!**/.terraform",
      "!**/.astro"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/apps/web/**"],
      "linter": {
        "rules": {
          "a11y": {
            "preset": "recommended"
          },
          "security": {
            "preset": "recommended",
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
